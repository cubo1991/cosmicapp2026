rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: verificar si el usuario es admin.
    // Admin = tiene un doc en /admins con su uid como ID (ver más abajo).
    // No usamos custom claims porque requerirían Cloud Functions con
    // Admin SDK para setearlos; un doc de Firestore alcanza para este caso.
    function isAdmin() {
      return request.auth.uid != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fase 3 de docs/PLAN_MULTI_LIGA.md. OJO: la web navega con sesion anonima
    // para el uso normal (ver src/hooks/useFirebaseAuth.ts) — el login con
    // Google es solo para /admin. Por eso esta funcion sirve para blindar
    // pertenencia a una liga (miembrosUid guarda uids reales, de cuentas no
    // anonimas), pero TODAVIA no se usa para copas/matches: exigirla ahi
    // dejaria afuera a cualquier sesion anonima, o sea a la app entera tal
    // como se usa hoy. Queda para cuando el juego en si pida login real.
    function perteneceALiga(ligaId) {
      return ligaId != null &&
        exists(/databases/$(database)/documents/ligas/$(ligaId)) &&
        request.auth.uid in get(/databases/$(database)/documents/ligas/$(ligaId)).data.get('miembrosUid', []);
    }

    // ============ CAMPOS DE RESULTADO ============
    // Estos campos los escribe SOLO la Cloud Function (finalizarPartida y
    // crearPartida), que usa el Admin SDK y no pasa por estas reglas. Bloquearlos
    // acá impide que alguien con la clave pública de la app —que viaja en el
    // bundle y en el APK, o sea, cualquiera— se invente sus propios puntos
    // escribiendo directo en Firestore.
    //
    // Los admins conservan el permiso: ya tienen esa potestad por otras vías y
    // algunos flujos del panel todavía los tocan.
    function noTocaCampos(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // ============ ADMINS ============
    // Cada admin puede leer su propio doc (para que el cliente sepa si lo es).
    // Nadie puede crear/borrar admins desde el cliente: se hace a mano
    // desde la consola de Firebase.
    match /admins/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
    }

    // ============ JUGADORES ============
    // Nota: "jugadores" son perfiles de torneo gestionados por quien organiza,
    // no cuentas 1:1 con el uid de quien los crea. El doc ID es autogenerado.
    //
    // VINCULACIÓN DE CUENTA: un jugador puede tener un campo `uid` que lo ata a
    // una cuenta de Firebase Auth. Se usa para que alguien que entra por primera
    // vez (sobre todo desde la app Android) reclame su jugador histórico en vez
    // de crear un duplicado. El campo es opcional: los jugadores sin `uid` son
    // los que todavía nadie reclamó.
    //
    // El resto de las escrituras sobre players siguen abiertas a cualquier
    // usuario autenticado, porque el cálculo de puntos actualiza `stats` y
    // `estadisticas` de todos los jugadores de una partida, no solo del propio.
    // Por eso acá se protege únicamente el campo `uid`.
    match /players/{userId} {
      // El update no toca `uid`: es una escritura normal (stats, nombre, etc.).
      function noTocaUid() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
      }

      // Reclamo válido: el jugador no fue reclamado todavía, quien reclama lo
      // hace para sí mismo, no es un usuario anónimo, y no aprovecha para
      // cambiar ningún otro campo en la misma escritura.
      function esReclamoValido() {
        return !resource.data.keys().hasAny(['uid']) &&
               request.resource.data.uid == request.auth.uid &&
               request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
      }

      // Leer: todos los usuarios autenticados
      allow read: if request.auth.uid != null;

      // Crear: cualquier usuario autenticado, con nombre y email
      allow create: if request.auth.uid != null &&
                      request.resource.data.name != null &&
                      request.resource.data.email != null;

      // Actualizar: escrituras normales del sistema, o un reclamo de vinculación.
      // Un `uid` ya asignado solo lo puede cambiar un admin (para deshacer una
      // vinculación equivocada).
      // Las estadisticas historicas de la LCE tambien quedan cerradas: las
      // escribe la Cloud Function al finalizar una partida, y el panel admin a
      // mano para las que no salen de ninguna (victorias especiales, campañas,
      // pijones). Un jugador comun nunca necesita tocarlas, y si pudiera se
      // inflaria las copas ganadas.
      // `ligas` (a que ligas pertenece) tampoco lo puede tocar un jugador
      // comun: el alta a una liga es manual, la hace el admin (buscando el
      // nombre o por invitacion) — ver docs/PLAN_MULTI_LIGA.md Fase 4.
      allow update: if request.auth.uid != null &&
                       (noTocaUid() || esReclamoValido() || isAdmin()) &&
                       (noTocaCampos(['stats', 'estadisticas', 'last10Score', 'last3Score', 'ligas'])
                        || isAdmin());

      // Borrar: solo admin
      allow delete: if isAdmin();

      // ====== SUBCOLECCIÓN: ÚLTIMAS PARTIDAS ======
      match /lastMatches/{matchId} {
        // Leer: todos los usuarios autenticados
        allow read: if request.auth.uid != null;

        // Crear/Actualizar: solo sistema (via Cloud Functions o servidor)
        allow create, update: if request.auth.uid != null;

        // Borrar: solo admin
        allow delete: if isAdmin();
      }

      // ====== SUBCOLECCIÓN: ESTADISTICAS POR LIGA (Fase 2/3 del multi-liga) ======
      // A diferencia de lastMatches, esta si queda acotada a quien pertenece a
      // la liga: es una coleccion nueva que hoy no lee ningun cliente, asi que
      // restringirla no rompe nada existente. La escribe solo la Cloud
      // Function (Admin SDK, no pasa por estas reglas) o un admin a mano.
      match /ligaStats/{ligaId} {
        allow read: if request.auth.uid != null && (perteneceALiga(ligaId) || isAdmin());
        allow write: if isAdmin();
      }
    }
    
    // ============ PARTIDAS ============
    match /matches/{matchId} {
      // Leer: todos los usuarios autenticados
      allow read: if request.auth.uid != null;
      
      // Crear: cualquier usuario autenticado
      allow create: if request.auth.uid != null &&
                       request.resource.data.nombre != null &&
                       request.resource.data.jugadores != null;
      
      // Actualizar: solo si la partida no está finalizada, o es admin.
      // Además, los puntos cargados (`jugadores`, `resumen`) y la auditoría solo
      // los escribe la Cloud Function: si no, cualquiera se inventa su puntaje.
      allow update: if request.auth.uid != null &&
                       (request.resource.data.estado == 'activa' || isAdmin()) &&
                       (noTocaCampos(['jugadores', 'resumen', 'auditoria']) || isAdmin());
      
      // Borrar: solo admin
      allow delete: if isAdmin();
    }
    
    // ============ COPAS ============
    match /copas/{copaId} {
      // Leer: todos los usuarios autenticados
      allow read: if request.auth.uid != null;
      
      // Crear: cualquier usuario autenticado
      allow create: if request.auth.uid != null &&
                       request.resource.data.nombre != null;
      
      // Actualizar: la tabla de la copa y su ganador los escribe solo la Cloud
      // Function. Agregar una partida al ciclo (`partidas`) sigue abierto,
      // porque todavía hay flujos de la web que lo hacen.
      allow update: if request.auth.uid != null &&
                       (noTocaCampos(['ranking', 'ganador']) || isAdmin());
      
      // Borrar: solo admin o si aún está en planificación
      allow delete: if isAdmin() ||
                       (request.auth.uid != null &&
                        resource.data.estado == 'planificada');
    }
    
    // ============ LIGAS ============
    match /ligas/{ligaId} {
      // Leer: todos los usuarios autenticados
      allow read: if request.auth.uid != null;
      
      // Crear: cualquier usuario autenticado
      allow create: if request.auth.uid != null &&
                       request.resource.data.nombre != null;
      
      // Actualizar: cualquier usuario autenticado, salvo la lista de miembros.
      // Nota: "creador" guarda un playerId (perfil de torneo), no un uid de
      // Auth, así que no se puede comparar contra request.auth.uid.
      //
      // MIEMBROS: el alta es manual y la hace el admin (buscando el nombre o
      // por invitación) — ver docs/PLAN_MULTI_LIGA.md Fase 4. Por eso
      // `miembros`/`miembrosUid` quedan cerrados a cualquiera que no sea
      // admin (o la Cloud Function de alta, que usa Admin SDK y no pasa por
      // estas reglas).
      allow update: if request.auth.uid != null &&
                       (noTocaCampos(['miembros', 'miembrosUid']) || isAdmin());

      // Borrar: solo admin, o cualquier autenticado si aún está en planificación
      allow delete: if isAdmin() ||
                       (request.auth.uid != null &&
                        resource.data.estado == 'planificada');
    }
    
    // ============ ALIENS ============
    // Catálogo del juego: lo leen la lista de aliens, el asignador aleatorio,
    // JoinMatch, el perfil de jugador y el generador de nombres. En la práctica
    // es de solo lectura (addAlien() existe en firebase/db.ts pero no lo llama
    // ninguna pantalla), así que las escrituras quedan para admin.
    match /alienList/{alienId} {
      allow read: if request.auth.uid != null;
      allow write: if isAdmin();
    }

    // ============ SNAPSHOTS ============
    match /snapshots/{snapshotId} {
      allow read, write: if request.auth.uid != null;
    }

    // ============ DEFAULT ============
    // Denegar todo lo que no esté explícitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
